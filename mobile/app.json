{
  "expo": {
    "name": "HAKI",
    "slug": "haki-audio-transcriber",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#faf8ff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      "expo-splash-screen"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ajawhary.haki",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "HAKI needs microphone access to record Twi audio for transcription.",
        "NSPhotoLibraryUsageDescription": "HAKI needs access to select audio files for transcription."
      }
    },
    "android": {
      "package": "com.ajawhary.haki",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#004ac6"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "fb61b3a4-1afb-4923-865b-99132604436d"
      }
    }
  }
}
