{
  "name": "haki-audio-transcriber",
  "version": "2.0.0",
  "main": "index.ts",
  "scripts": {
    "postinstall": "node scripts/patch-foojay-gradle.js",
    "start": "expo start --go",
    "android": "EXPO_USE_COMMUNITY_AUTOLINKING=1 expo run:android",
    "build:apk:local": "node scripts/patch-foojay-gradle.js && cd android && ./gradlew assembleRelease && cp app/build/outputs/apk/release/app-release.apk ../Haki.apk && cp ../Haki.apk ../../Haki.apk"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@react-navigation/bottom-tabs": "^7.16.2",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.3.14",
    "expo": "~56.0.8",
    "expo-clipboard": "~56.0.4",
    "expo-document-picker": "~56.0.4",
    "expo-file-system": "~56.0.8",
    "expo-font": "^56.0.5",
    "expo-sharing": "~56.0.18",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "^4.25.2"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "private": true
}
